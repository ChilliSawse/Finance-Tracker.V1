{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger.invalid/ref/schemas/merchants.schema.json",
  "title": "Merchants (R3 section 5.2 as changed by D5 section 7.1). Built file: merged from merchants/*.json",
  "type": "object",
  "required": ["schema", "rev", "merchants"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "rev": { "$ref": "common.schema.json#/$defs/rev" },
    "merchants": { "type": "array", "items": { "$ref": "#/$defs/merchant" } }
  },
  "$defs": {
    "merchant": {
      "type": "object",
      "required": ["id", "key", "name", "categoryId", "match", "confidence", "reviewed"],
      "additionalProperties": false,
      "anyOf": [{ "required": ["source"] }, { "required": ["evidence"] }],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "key": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "type": { "enum": ["merchant", "keyword"] },
        "categoryId": { "$ref": "common.schema.json#/$defs/id" },
        "direction": { "enum": ["any", "credit", "debit"] },
        "match": { "enum": ["key", "keyword", "word"], "description": "key/keyword = R3 5.2; word = whole word or phrase on the normalised text (D5). Never a regular expression." },
        "patterns": { "$ref": "common.schema.json#/$defs/stringList" },
        "aliases": { "$ref": "common.schema.json#/$defs/stringList" },
        "guardedPatterns": {
          "type": "array",
          "items": {
            "type": "object", "required": ["pattern", "requireContext"], "additionalProperties": false,
            "properties": { "pattern": { "type": "string", "minLength": 1 }, "requireContext": { "$ref": "common.schema.json#/$defs/stringList" } }
          }
        },
        "tokenPatterns": { "$ref": "common.schema.json#/$defs/stringList" },
        "excludePatterns": { "$ref": "common.schema.json#/$defs/stringList" },
        "requireContext": { "$ref": "common.schema.json#/$defs/stringList" },
        "confirmed": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"], "description": "Only high skips the suggested mark" },
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["url", "retrieved"], "additionalProperties": false,
            "properties": { "url": { "$ref": "common.schema.json#/$defs/text" }, "retrieved": { "$ref": "common.schema.json#/$defs/date" } }
          }
        },
        "source": { "$ref": "common.schema.json#/$defs/text" },
        "sourceType": { "type": "string", "maxLength": 100 },
        "states": { "type": "array", "items": { "enum": ["ALL", "NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"] }, "uniqueItems": true },
        "reviewed": { "$ref": "common.schema.json#/$defs/dateOrNull" },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "if": { "properties": { "match": { "const": "word" } }, "required": ["match"] },
      "then": { "anyOf": [{ "required": ["patterns"] }, { "required": ["guardedPatterns"] }, { "required": ["tokenPatterns"] }] }
    }
  }
}
