{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger.invalid/ref/schemas/saving-model.schema.json",
  "title": "Saving model envelope (R3 section 5.4). The model is also run through validateModelDef unchanged.",
  "type": "object",
  "required": ["schema", "id", "version", "meta", "model"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "meta": {
      "type": "object",
      "required": ["title", "blurb", "source", "licence", "reviewed", "requires"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "blurb": { "$ref": "common.schema.json#/$defs/text" },
        "after": { "type": "string", "maxLength": 1000, "description": "Credits the idea, never a trademark" },
        "source": { "$ref": "common.schema.json#/$defs/text" },
        "sourceKind": { "type": "string", "maxLength": 200 },
        "retrieved": { "$ref": "common.schema.json#/$defs/date" },
        "licence": { "type": "string", "minLength": 1, "maxLength": 100 },
        "reviewed": { "$ref": "common.schema.json#/$defs/dateOrNull" },
        "status": { "type": "string", "maxLength": 300 },
        "checks": { "type": "object" },
        "requires": {
          "type": "object",
          "required": ["engine"],
          "properties": { "engine": { "type": "string", "minLength": 1, "maxLength": 64 } }
        }
      }
    },
    "model": { "$ref": "#/$defs/modelDef" }
  },
  "$defs": {
    "modelDef": {
      "type": "object",
      "required": ["id", "name", "basis", "engine", "buckets", "rules"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "after": { "type": "string" },
        "basis": { "enum": ["net", "gross", "realRevenue"] },
        "engine": { "enum": ["expenses-first", "fixed"] },
        "guide": { "type": "object" },
        "buckets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bucket" } },
        "virtual": { "type": "array" },
        "rules": {
          "type": "object",
          "required": ["coreBuckets", "maxDepth"],
          "properties": {
            "coreBuckets": { "type": "array", "items": { "type": "string" } },
            "maxDepth": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "bucket": {
      "type": "object",
      "required": ["name", "slot", "kind", "pct"],
      "properties": {
        "role": { "enum": ["daily", "splurge", "smile", "fire", "mojo", "grow"] },
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "slot": { "type": "integer", "minimum": 1, "maximum": 10 },
        "kind": { "enum": ["spend", "save"] },
        "pct": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "pattern": "^(remainder|expenses-first:.+)$" }] }
      }
    }
  }
}
