{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger.invalid/ref/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "dateOrNull": { "type": ["string", "null"], "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "rev": { "type": "integer", "minimum": 1 },
    "schemaInt": { "type": "integer", "minimum": 1 },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bucketRole": { "enum": ["daily", "splurge", "smile", "fire", "mojo", "grow", "none"] },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true }
  }
}
